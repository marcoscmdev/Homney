<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.HomneyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Color principal: amarillo miel -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/text</item>
        <!-- Color secundario: verde pastel -->
        <item name="colorSecondary">@color/green</item>
        <item name="colorSecondaryVariant">@color/green_dark</item>
        <item name="colorOnSecondary">@color/text</item>
        <!-- Fondo general: crema -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <!-- Barra de estado -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/accent_dark</item>
    </style>

    <style name="Theme.HomneyApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.HomneyApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.HomneyApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
