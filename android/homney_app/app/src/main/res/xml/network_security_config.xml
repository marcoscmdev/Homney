<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red.
    - HTTP permitido SOLO para el dominio del backend (AwardSpace plan gratuito
      no garantiza HTTPS estable). El resto del tráfico exige HTTPS.
    - No se confía en certificados de usuario (evita MITM en producción).
-->
<network-security-config>
    <!-- Política global: solo HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Excepción explícita para el backend: permite HTTP en este dominio -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">homneyapp.atwebpages.com</domain>
    </domain-config>
</network-security-config>
