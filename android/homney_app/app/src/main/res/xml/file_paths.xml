<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Directorio privado de la app en almacenamiento externo → Pictures/
        La cámara escribe aquí, luego Utilidades.uriABytesJpeg() lee con ContentResolver.
        Requiere android:authorities="${applicationId}.fileprovider" en el Manifest.
    -->
    <external-files-path
        name="camera_images"
        path="Pictures/" />
</paths>
