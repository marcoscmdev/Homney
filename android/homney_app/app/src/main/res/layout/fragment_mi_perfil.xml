<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_box"
        android:layout_margin="@dimen/activity_vertical_margin"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Mi perfil"
            style="@style/Homney.Text.Title"
            android:layout_marginBottom="16dp" />

        <!-- Separador -->
        <View style="@style/Homney.Divider" android:layout_marginBottom="20dp" />

        <!-- ── Avatar ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/iv_avatar_perfil"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_cambiar_foto_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📷 Cambiar foto"
                android:textSize="13sp"
                android:textColor="@color/accent_dark"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Separador -->
        <View style="@style/Homney.Divider" android:layout_marginBottom="20dp" />

        <!-- ── Información personal ───────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información personal"
            style="@style/Homney.Text.Subtitle"
            android:layout_marginBottom="14dp" />

        <!-- Email (solo lectura) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_email_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface2"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="14dp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOMBRE"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_nombre_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="Tu nombre"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="14dp"
            android:singleLine="true" />

        <!-- Teléfono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TELÉFONO"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_telefono_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="Número de móvil"
            android:inputType="phone"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="14dp"
            android:singleLine="true" />

        <!-- Sexo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genero"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_sexo_perfil"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginBottom="14dp" />

        <!-- Fecha de nacimiento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FECHA DE NACIMIENTO"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_fecha_nac_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="aaaa-mm-dd"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="20dp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:singleLine="true" />

        <!-- Separador -->
        <View style="@style/Homney.Divider" android:layout_marginBottom="16dp" />

        <!-- ── Contraseña ──────────────────────────────────── -->
        <Button
            android:id="@+id/btn_cambiar_pass_perfil"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/Homney.Button.Ghost"
            android:text="🔐  Cambiar contraseña"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_eliminar_cuenta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            style="@style/Homney.Button.Ghost"
            android:text="⛔️ Eliminar cuenta"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Separador -->
        <View style="@style/Homney.Divider" android:layout_marginBottom="16dp" />

        <!-- ── Botones ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancelar_perfil"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                style="@style/Homney.Button.Ghost"
                android:text="Cancelar"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_guardar_perfil"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                style="@style/Homney.Button.Primary"
                android:text="Guardar"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
