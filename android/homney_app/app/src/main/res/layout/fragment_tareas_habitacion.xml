<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.fragmento2_mihogar.FragmentoTareasHabitacion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Cabecera con nombre de la habitación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_titulo_habitacion"
                style="@style/Homney.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Cocina" />

            <TextView
                android:id="@+id/tag_num_tareas"
                style="@style/Homney.Tag.Yellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3 pendientes" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════
             SECCIÓN 1 — MIS TAREAS
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_header_mis_tareas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/Homney.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mis tareas" />

            <TextView
                android:id="@+id/chevron_mis_tareas_hab"
                style="@style/Homney.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_mis_tareas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/container_mis_tareas_hab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sin_mis_tareas_hab"
                    style="@style/Homney.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Cargando…" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════
             SECCIÓN 2 — OTRAS TAREAS DE LA HABITACIÓN
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_header_otras_tareas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/Homney.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Otras tareas" />

            <TextView
                android:id="@+id/chevron_otras_tareas_hab"
                style="@style/Homney.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_otras_tareas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/container_otras_tareas_hab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sin_otras_tareas_hab"
                    style="@style/Homney.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No hay más tareas en esta habitación." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════════════════════════════════
             SECCIÓN 3 — COMPLETADAS ESTE MES
        ════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_header_completadas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/Homney.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Completadas este mes" />

            <TextView
                android:id="@+id/chevron_completadas_hab"
                style="@style/Homney.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_completadas_hab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:id="@+id/container_completadas_hab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sin_completadas_hab"
                    style="@style/Homney.Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Sin tareas completadas este mes." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
