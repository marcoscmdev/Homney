<?xml version="1.0" encoding="utf-8"?>
<!--
    Item card del muro. Flujo vertical garantizado (LinearLayout):
      1. TITULO
      2. CUERPO
      3. IMAGEN de publicación  (GONE por defecto, visible cuando hay imagen)
      4. FECHA · AUTOR
    imagen_publi_muro se conserva con visibility="gone" por compatibilidad con el adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_margin="16dp">

    <!-- 1. FILA CABECERA: TITULO + BOTÓN ELIMINAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/titulo_publi_muro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Homney.Text.Title"
            android:gravity="center_horizontal"
            android:text="Titulo" />

        <ImageView
            android:id="@+id/btn_eliminar_publi"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Eliminar publicación"
            android:visibility="gone"
            android:padding="2dp" />

    </LinearLayout>

    <!-- Separador decorativo bajo el título -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        android:layout_marginBottom="10dp" />

    <!-- 2. CUERPO -->
    <TextView
        android:id="@+id/body_muro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Homney.Text.Body"
        android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        android:layout_marginBottom="10dp" />

    <!-- 3. IMAGEN PRINCIPAL de la publicación (visible solo si el adapter la carga) -->
    <ImageView
        android:id="@+id/img_muro_publi"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <!-- Legacy: imagen_publi_muro — siempre oculto, mantenido por compatibilidad -->
    <ImageView
        android:id="@+id/imagen_publi_muro"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- 4. FECHA · AUTOR -->
    <TextView
        android:id="@+id/fecha_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Homney.Text.Muted"
        android:gravity="center_horizontal"
        android:text="Lunes - 23 Febrero 2026 · Usuario"
        android:layout_marginTop="4dp" />

</LinearLayout>
