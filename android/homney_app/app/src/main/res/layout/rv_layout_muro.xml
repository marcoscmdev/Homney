<?xml version="1.0" encoding="utf-8"?>
<!--
    Item card del muro — misma estética que el resto de CardViews de la app.
    Flujo vertical:
      1. FILA CABECERA: TÍTULO + botón eliminar
      2. SEPARADOR
      3. CUERPO
      4. IMAGEN (GONE por defecto)
      5. FECHA · AUTOR
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 1. FILA CABECERA: TÍTULO + BOTÓN ELIMINAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/titulo_publi_muro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Homney.Text.Title"
                android:gravity="start" />

            <ImageView
                android:id="@+id/btn_eliminar_publi"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="@string/dialog_eliminar_pub_titulo"
                android:visibility="gone"
                android:padding="2dp" />

        </LinearLayout>

        <!-- Separador decorativo bajo el título -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="10dp" />

        <!-- 2. CUERPO -->
        <TextView
            android:id="@+id/body_muro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Homney.Text.Body"
            android:gravity="start"
            android:layout_marginBottom="10dp" />

        <!-- 3. IMAGEN PRINCIPAL (visible solo si el adapter la carga) -->
        <ImageView
            android:id="@+id/img_muro_publi"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="10dp"
            android:background="@color/border"
            android:visibility="gone" />

        <!-- Legacy: siempre oculto, mantenido por compatibilidad con el adapter -->
        <ImageView
            android:id="@+id/imagen_publi_muro"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <!-- 4. FECHA · AUTOR -->
        <TextView
            android:id="@+id/fecha_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Homney.Text.Muted"
            android:gravity="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
