<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="@dimen/activity_vertical_margin">

    <!-- ── Cabecera ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/homney_mate"
            android:layout_marginEnd="10dp"
            />

        <LinearLayout
            android:layout_width="226dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Homney Mate"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Homney.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu abeja obrera con IA"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Botón limpiar historial (pequeño, discreto) -->
            <ImageButton
                android:id="@+id/btn_limpiar_historial"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_limpiar_chat"
                android:contentDescription="Limpiar historial"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_marginEnd="4dp" />

            <!-- Botón amarillo Cerrar -->
            <Button
                android:id="@+id/btn_cerrar_ia"
                style="@style/Homney.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar"
                android:layout_marginEnd="4dp" />

            <!-- Botón Aceptar -->

        </LinearLayout>


    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ── Área de mensajes ── -->
    <ScrollView
        android:id="@+id/scroll_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/ll_mensajes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp" />

    </ScrollView>

    <!-- ── Indicador de carga ── -->
    <ProgressBar
        android:id="@+id/loading_ia"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        style="?android:attr/progressBarStyleSmall" />

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ── Barra de entrada ── -->
    <LinearLayout
        android:id="@+id/ll_barra_entrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/et_pregunta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Pregunta algo sobre el hogar..."
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btn_enviar_ia"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Enviar"
            android:padding="10dp" />

    </LinearLayout>

</LinearLayout>
