<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de un gasto en el historial de la Cartera.
    El importe (tv_importe) y el tag tipo (tv_tag_tipo) se colorean desde Java:
      - importe verde  → pagado por el usuario actual
      - importe rojo   → pagado por otro
      - tag amarillo   → tipo "fijo"
      - tag naranja    → tipo "ocasional"
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Icono de modo de pago -->
    <ImageView
        android:id="@+id/img_modo_pago"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_credit_card"
        android:background="@color/accent_background"
        android:padding="7dp"
        tools:ignore="ContentDescription" />

    <!-- Concepto + meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_concepto"
            style="@style/Homney.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Compra supermercado" />

        <!-- categoría · fecha · modo · quién pagó -->
        <TextView
            android:id="@+id/tv_meta_gasto"
            style="@style/Homney.Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            tools:text="Alimentación · 12/04/2026 · tarjeta · Pagaste tú" />
    </LinearLayout>

    <!-- Importe + tag tipo (columna derecha) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tv_importe"
            style="@style/Homney.Text.AmountPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="+35,00 €" />

        <TextView
            android:id="@+id/tv_tag_tipo"
            style="@style/Homney.Tag.Yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="FIJO" />
    </LinearLayout>

</LinearLayout>
