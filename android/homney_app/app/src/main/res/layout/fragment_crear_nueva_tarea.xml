<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_box"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Homney.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nueva_tarea_toolbar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nombre_tarea_nueva"
            style="@style/Homney.Text.Label"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <AutoCompleteTextView
            android:id="@+id/et_nombre_tarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:inputType="textAutoComplete"
            android:hint="@string/hint_tarea"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="14dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/habitacion_tarea_nueva"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_habitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duracion_nueva_tarea"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/np_horas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="14dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp"
                android:layout_marginEnd="10dp"/>
            <NumberPicker
                android:id="@+id/np_minutos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="14dp"
                android:paddingTop="12dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/num_veces"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_num_veces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="numberSigned"
            android:background="@drawable/bg_input"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="14dp"
            android:hint="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frecuencia_nueva_tarea"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_frecuencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input"
            android:entries="@array/frecuencia_options"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:popupBackground="@drawable/bg_input"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/asigna_tarea"
            style="@style/Homney.Text.Label"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_asigna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancelar_tarea"
                android:layout_width="0dp"
                android:layout_height="52dp"
                style="@style/Homney.Button.Ghost"
                android:text="@string/btn_cancelar"
                android:textSize="15sp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_crear_tarea"
                android:layout_width="0dp"
                android:layout_height="52dp"
                style="@style/Homney.Button.Primary"
                android:text="@string/btn_crear_tarea"
                android:textSize="15sp"
                android:layout_weight="1"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>