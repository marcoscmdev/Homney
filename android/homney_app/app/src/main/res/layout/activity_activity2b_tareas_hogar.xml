<?xml version="1.0" encoding="utf-8"?>
<!--
    WIZARD PASO 2b — Tareas del hogar
    Paso intermedio entre la configuración de habitaciones (Activity2) y los
    gastos recurrentes (Activity3). Permite asignar tareas sugeridas a cada
    habitación ya creada, con opción de añadir tareas personalizadas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ══ Barra superior del wizard ══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/surface">

        <Button
            android:id="@+id/btn_atras_tareas"
            style="@style/Homney.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Atrás"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paso 2 de 3"
            android:gravity="center"
            style="@style/Homney.Text.Muted"
            android:textSize="12sp" />

        <!-- Espacio simétrico al botón -->
        <View
            android:layout_width="70dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ══ Cabecera de sección ══════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧹 Tareas del hogar"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marca las tareas habituales de cada habitación. Puedes modificarlas en cualquier momento."
            style="@style/Homney.Text.Muted"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ══ Área desplazable con las secciones por habitación ══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/ll_secciones_habitaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- ══ Botones inferiores ════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/surface">

        <Button
            android:id="@+id/btn_omitir_tareas"
            style="@style/Homney.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Omitir"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_siguiente_tareas"
            style="@style/Homney.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Siguiente →" />

    </LinearLayout>

</LinearLayout>
