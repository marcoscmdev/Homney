<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/activity_vertical_margin">

    <!-- Campo: Correo electrónico -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/field_email"
        style="@style/Homney.Text.Label"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_mail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:inputType="textEmailAddress"
        android:hint="@string/hint_email"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="14sp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="14dp"
        android:singleLine="true"
        android:autofillHints="emailAddress" />

    <!-- Campo: Contraseña -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/field_password"
        style="@style/Homney.Text.Label"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:inputType="textPassword"
        android:hint="@string/hint_password"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="14sp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:autofillHints="password" />

    <!-- Olvidé mi contraseña -->
    <TextView
        android:id="@+id/tv_olvidar_pass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Olvidaste tu contraseña?"
        android:textColor="@color/accent_dark"
        android:textSize="12sp"
        android:layout_gravity="end"
        android:paddingBottom="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Recordar Sesión -->
    <CheckBox
        android:id="@+id/cb_recordar_sesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recordarme"
        style="@style/Homney.Text.Label"
        android:layout_marginBottom="6dp"
        android:buttonTint="@color/accent" />

    <!-- Botón Entrar -->
    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        style="@style/Homney.Button.Primary"
        android:text="@string/btn_entrar"
        android:textSize="15sp"
        android:layout_marginBottom="20dp" />

    <!-- ══ Separador "o continúa con" ══════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/muted"
            android:alpha="0.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  o continúa con  "
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/muted"
            android:alpha="0.4" />
    </LinearLayout>

    <!-- ══ Botón Google ════════════════════════════════════════ -->
    <Button
        android:id="@+id/btn_google"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        style="@style/Homney.Button.Green"
        android:text="Continuar con Google"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"
        />

</LinearLayout>
