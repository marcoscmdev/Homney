<?xml version="1.0" encoding="utf-8"?>
<!--
    WIZARD PASO FINAL — Resumen del registro
    Tarjeta 1: perfil + foto  |  Tarjeta 2: habitaciones  |  Tarjeta 3: gastos
    FAB flotante con HomneyMate  |  Banner de bienvenida IA al cargarse
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ══ CONTENIDO DESPLAZABLE ══════════════════════════════ -->
    <ScrollView
        android:id="@+id/scroll_resumen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ══ Cabecera ══════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tu_colmena_est_lista"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aqu_tienes_un_resumen_de_lo_que_has_configurado"
                style="@style/Homney.Text.Muted"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- ══ TARJETA 0: NOMBRE DEL HOGAR ══════════════════ -->
            <LinearLayout
                android:id="@+id/card_hogar_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_auth_box"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tu_hogar"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nombre_hogar_resumen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sin nombre"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/btn_nombrar_hogar"
                    style="@style/Homney.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nombrar"
                    android:textSize="13sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>

            <!-- ══ TARJETA 1: PERFIL ══════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_auth_box"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tu_perfil"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Avatar + datos en fila -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Zona foto (apilada con el botón de cambio) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/iv_avatar_resumen"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_avatar_circle"
                            android:clipToOutline="true" />

                        <TextView
                            android:id="@+id/tv_cambiar_foto_resumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Añadir foto"
                            android:textColor="@color/accent_dark"
                            android:textSize="11sp"
                            android:paddingTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Datos texto -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_nombre_resumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_email_resumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            style="@style/Homney.Text.Muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_rol_resumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/accent_dark"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ TARJETA 2: HABITACIONES ════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_auth_box"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tus_habitaciones"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_num_habitaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/accent_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Lista dinámica de habitaciones -->
                <LinearLayout
                    android:id="@+id/ll_habitaciones_resumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Placeholder mientras carga -->
                    <TextView
                        android:id="@+id/tv_hab_loading"
                        style="@style/Homney.Text.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando habitaciones…" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ TARJETA 3: GASTOS RECURRENTES ══════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_auth_box"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gastos_recurrentes_nuevo"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_gastos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 €"
                        android:textColor="@color/accent_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Lista dinámica de gastos -->
                <LinearLayout
                    android:id="@+id/ll_gastos_resumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_gastos_loading"
                        style="@style/Homney.Text.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando gastos…" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ Botón entrar ════════════════════════════════ -->
            <Button
                android:id="@+id/btn_entrar_colmena"
                style="@style/Homney.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entrar_a_la_colmena"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>


</FrameLayout>
