<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.fragmento2_mihogar.fragmento_mihogar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══════════════════════════════════════════
             TARJETA INFO HOGAR (número + clave)
        ══════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Icono hogar -->
                <ImageView
                    android:id="@+id/img_hogar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_home2"
                    android:background="@color/accent_background"
                    android:padding="10dp"
                    android:layout_marginEnd="14dp" />

                <!-- Datos del hogar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Título del hogar + lápiz editar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_hogar_titulo"
                            style="@style/Homney.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Hogar #12" />

                        <ImageView
                            android:id="@+id/iv_editar_nombre_hogar"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/outline_border_color_24"
                            android:contentDescription="Editar nombre del hogar"
                            android:tint="@color/muted"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </LinearLayout>

                    <!-- Botón invitar + código oculto -->
                    <!-- El código se guarda en Java (claveInvActual), no se muestra -->
                    <TextView
                        android:id="@+id/tareas_pendientes"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        tools:text="AB12XY" />

                    <Button
                        android:id="@+id/btn_invitar_hogar"
                        style="@style/Homney.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/invita_a_la_colmena" />

                    <!-- Código de invitación visible bajo el botón -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            style="@style/Homney.Text.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/codigo_label"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_codigo_invi"
                            style="@style/Homney.Tag.Yellow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            tools:text="AB12XY" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════
             SECCIÓN: COMPAÑEROS DEL HOGAR
        ══════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Homney.Text.Title"
            android:text="@string/miembros_hogar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- Contenedor dinámico de tarjetas de usuarios (se rellena desde Java) -->
        <LinearLayout
            android:id="@+id/container_usuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <!-- Placeholder visible en el editor (se reemplaza en tiempo de ejecución) -->
            <TextView
                android:id="@+id/tv_sin_usuarios"
                style="@style/Homney.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/cargando_companeros"
                android:visibility="visible" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════
             SECCIÓN: HABITACIONES
        ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Homney.Text.Title"
                android:text="@string/habitaciones" />

            <ImageView
                android:id="@+id/btn_anadir_habitacion"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add"
                android:background="@color/accent_background"
                android:padding="6dp"
                android:contentDescription="Añadir habitación" />

        </LinearLayout>

        <!-- Grid de habitaciones (filas de 2 columnas, se rellena desde Java) -->
        <LinearLayout
            android:id="@+id/grid_habitaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/tv_sin_habitaciones"
                style="@style/Homney.Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/cargando_habitaciones"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
