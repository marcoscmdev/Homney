<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_centerHorizontal="true">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_auth_box"
    android:fillViewport="true"
    android:orientation="vertical"
    android:layout_margin="@dimen/activity_vertical_margin"
    android:layout_gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" 💬 Nueva publicación"
        style="@style/Homney.Text.Title"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_publi"
        style="@style/Homney.Text.Label"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_gravity="left"
        />
    <EditText
        android:id="@+id/et_titulo_publi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/ejemplo_titulo_muro"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="14sp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="14dp"
        android:singleLine="true"
        android:layout_margin="8dp"/>
    <!-- Previsualización de la imagen seleccionada/tomada -->
    <ImageView
        android:id="@+id/img_preview_foto"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_margin="8dp"
        android:scaleType="centerCrop"
        android:background="#F0EEEE"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contenido_publi"
        style="@style/Homney.Text.Label"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_gravity="left"
        />

    <EditText
        android:id="@+id/et_cuerpo_publi"
        android:layout_width="283dp"
        android:layout_height="163dp"
        android:layout_margin="8dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:hint="@string/ejemplo_publicacion"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp"
        android:singleLine="false"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/img_sube_foto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_img_galeria" />

        <ImageView
            android:id="@+id/img_lanza_cam"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_photo" />

        <TextView
            android:id="@+id/tv_quitar_foto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="✕ Quitar foto"
            android:textSize="12sp"
            android:textColor="#E05C5C"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="10dp"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_cancelar_publi"
            android:layout_width="0dp"
            android:layout_height="52dp"
            style="@style/Homney.Button.Ghost"
            android:text="@string/btn_cancelar"
            android:textSize="15sp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_crear_publi"
            style="@style/Homney.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_publicar"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
</ScrollView>