<?xml version="1.0" encoding="utf-8"?>
<!--
    Logo Homney — Vector Drawable convertido desde SVG.
    Uso en layouts: <ImageView android:src="@drawable/ic_logo_homney" />
    Tamaño recomendado: 28dp–48dp
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="40"
    android:viewportHeight="40"
    >

    <!-- Hexágono exterior  fill rgba(45,36,22,.14)  stroke rgba(45,36,22,.42) -->
    <path
        android:pathData="M20,4L34,12V28L20,36L6,28V12L20,4Z"
        android:fillColor="@color/border"
        android:strokeColor="@color/border2"
        android:strokeWidth="1.9" />

    <!-- Hexágono interior  fill rgba(45,36,22,.07)  stroke rgba(45,36,22,.22) -->
    <path
        android:pathData="M20,9L30,15V25L20,31L10,25V15L20,9Z"
        android:fillColor="#122D2416"
        android:strokeColor="#382D2416"
        android:strokeWidth="1.2" />

    <!-- Círculo central  fill rgba(45,36,22,.56) -->
    <path
        android:pathData="M20,20m-4.5,0a4.5,4.5,0,1,1,9,0a4.5,4.5,0,1,1,-9,0"
        android:fillColor="#8F2D2416" />


</vector>
