<?xml version="1.0" encoding="utf-8"?>
<!-- Botón danger: fondo rojo claro, borde rojo suave -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FACECC" />
            <stroke android:width="1dp" android:color="@color/danger" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_background" />
            <stroke android:width="1dp" android:color="#4DE05C5C" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
