<?xml version="1.0" encoding="utf-8"?>
<!-- Input / EditText normal: fondo surface_two, borde border, esquinas 10dp -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Con foco: borde accent -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_two" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_two" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
