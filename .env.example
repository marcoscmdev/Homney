# ============================================================
#  HOMNEY — Variables de entorno
#  Copia este fichero como  .env  y rellena tus valores reales.
#  NUNCA subas el fichero .env a Git (ya está en .gitignore).
# ============================================================

# ── Base de datos LOCAL ──────────────────────────────────────
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=nombre_bbdd_local
DB_USER_LOCAL=usuario_local
DB_PASS_LOCAL=contraseña_local

# ── Base de datos PRODUCCIÓN ─────────────────────────────────
DB_HOST_PROD=host_produccion
DB_NAME_PROD=nombre_bbdd_prod
DB_USER_PROD=usuario_prod
DB_PASS_PROD=contraseña_prod

# ── Asistente IA (proxy PHP → proveedor) ─────────────────────
# Groq (gratuito): https://console.groq.com/keys
IA_API_URL=https://api.groq.com/openai/v1/chat/completions
IA_API_KEY=tu_clave_groq_aqui
IA_MODEL=llama-3.3-70b-versatile

# Alternativas compatibles (descomenta la que uses):
# OpenRouter → https://openrouter.ai/keys
# IA_API_URL=https://openrouter.ai/api/v1/chat/completions
# IA_API_KEY=tu_clave_openrouter_aqui
# IA_MODEL=qwen/qwen3-235b-a22b:free

# DeepSeek → https://platform.deepseek.com/api_keys
# IA_API_URL=https://api.deepseek.com/chat/completions
# IA_API_KEY=tu_clave_deepseek_aqui
# IA_MODEL=deepseek-chat

# ── Android (secrets.properties) ─────────────────────────────
# El fichero android/homney_app/secrets.properties sigue el mismo patrón.
# Añade ahí las claves que consuma la app directamente (si las hay).
# GEMINI_API_KEY=  ← borrado, no se usa en la app
